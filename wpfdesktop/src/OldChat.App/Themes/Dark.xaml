    <SolidColorBrush x:Key="Nick3" Color="#A79BEF" />
    <SolidColorBrush x:Key="Nick4" Color="#8DCB6C" />
    <SolidColorBrush x:Key="Nick5" Color="#7DCADC" />
    <SolidColorBrush x:Key="Nick6" Color="#75AEDF" />
    <SolidColorBrush x:Key="Nick7" Color="#E68CAF" />
