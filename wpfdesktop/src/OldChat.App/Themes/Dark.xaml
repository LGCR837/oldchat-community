<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色：逐项对齐官方客户端 values-night/colors.xml -->
    <SolidColorBrush x:Key="WindowBg" Color="#111827" />
    <SolidColorBrush x:Key="TitleBarBg" Color="#1F2937" />
    <SolidColorBrush x:Key="RailBg" Color="#1F2937" />
    <SolidColorBrush x:Key="PanelBg" Color="#1F2937" />
    <SolidColorBrush x:Key="PanelBgAlt" Color="#111827" />
    <!-- 官方夜间聊天底图：深藏青 + 同款涂鸦 -->
    <ImageBrush x:Key="ChatBg" ImageSource="/Assets/chat_bg_night.jpg"
                TileMode="Tile" Viewport="0,0,232,232" ViewportUnits="Absolute"
                Stretch="UniformToFill" />
    <SolidColorBrush x:Key="InputBg" Color="#1F2937" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#111827" />

    <SolidColorBrush x:Key="Divider" Color="#374151" />
    <SolidColorBrush x:Key="BorderSoft" Color="#374151" />
    <SolidColorBrush x:Key="DividerSoft" Color="#273244" />
    <SolidColorBrush x:Key="InputBorder" Color="#374151" />

    <SolidColorBrush x:Key="AccentBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#F9FAFB" />
    <SolidColorBrush x:Key="AccentSoft" Color="#273244" />

    <SolidColorBrush x:Key="HoverBg" Color="#273244" />
    <SolidColorBrush x:Key="SelectedBg" Color="#273244" />

    <SolidColorBrush x:Key="BubbleInBg" Color="#2A313A" />
    <SolidColorBrush x:Key="BubbleInText" Color="#F9FAFB" />
    <SolidColorBrush x:Key="BubbleInBorder" Color="#2A313A" />
    <SolidColorBrush x:Key="BubbleOutBg" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BubbleOutText" Color="#111827" />

    <SolidColorBrush x:Key="ReplyBg" Color="#273244" />
    <SolidColorBrush x:Key="ReplyAccent" Color="#3390EC" />
