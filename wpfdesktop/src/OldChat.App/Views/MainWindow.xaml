<Window x:Class="OldChat.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OldChat.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="旧聊" Height="740" Width="1160" MinHeight="580" MinWidth="920"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource RailBg}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                <Grid>
                    <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                        <RadioButton x:Name="TabMessages" Style="{StaticResource RailButton}"
                                     GroupName="Rail" IsChecked="True" Content="&#xE8BD;"
                                     HorizontalAlignment="Center" ToolTip="消息"
                                     Click="TabMessages_Click" />
                        <RadioButton x:Name="TabFriends" Style="{StaticResource RailButton}"
                                     GroupName="Rail" Content="&#xE716;"
                                     HorizontalAlignment="Center" ToolTip="好友" Margin="0,2,0,0"
                                     Click="TabFriends_Click" />
                        <RadioButton x:Name="TabDiscover" Style="{StaticResource RailButton}"
                                     GroupName="Rail" Content="&#xE721;"
                                     HorizontalAlignment="Center" ToolTip="发现" Margin="0,2,0,0"
                                     Click="TabDiscover_Click" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,14">
                        <controls:AvatarImage x:Name="SelfAvatar" Width="30" Height="30"
                                              HorizontalAlignment="Center"
                                              ToolTip="我的" MouseLeftButtonUp="SelfAvatar_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 会话列表 -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,12,12,6">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Height="30"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="28,0,10,0" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <ListBox x:Name="ConversationList" Grid.Row="1"
                             ItemsSource="{Binding ConversationsView}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ConversationItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <controls:AvatarImage Grid.Column="0" Width="46" Height="46"
                                                          Url="{Binding AvatarUrl}"
                                                          FallbackText="{Binding Title}"
                                                          IsOnline="{Binding IsOnline}"
                                                          ShowOnline="True" />

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <Border Style="{StaticResource UnreadBadge}" Margin="0,5,0,0"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Unread}" FontSize="10"
                                                       Foreground="{DynamicResource BadgeText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Padding="16,7"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding StatusLine}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 聊天区 -->
            <Grid Grid.Column="2" Background="{DynamicResource ChatBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部合并条：左边会话标题，右边窗口按钮，整条可拖 -->
                <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TopBar_MouseDown">
                    <Grid>
                        <!-- 未选会话：品牌与连接状态 -->
                        <Grid x:Name="BrandPanel" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="旧聊" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" />
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="10,0,0,0"
                                         Fill="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionText" Text="连接中" FontSize="11" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                        </Grid>

                        <!-- 已选会话：头像 + 单行标题人数，异常时第二行连接状态 -->
                        <Grid x:Name="ChatHeaderPanel" Margin="16,0,10,0" VerticalAlignment="Center"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:AvatarImage Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center"
                                                  Url="{Binding Selected.AvatarUrl}"
                                                  IsOnline="{Binding Selected.IsOnline}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding HeaderTitle}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="400"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ChatConnectionText" Text="重连中" FontSize="11" Margin="0,1,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="MenuButton" Style="{StaticResource WindowButton}" Height="52"
                                    FontSize="16" Content="&#xE712;" ToolTip="设置" Click="Menu_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource PopupMenu}" Opened="Menu_Opened">
                                        <MenuItem x:Name="MenuRound" Style="{StaticResource PopupMenuItem}"
                                                  Header="圆角气泡" IsCheckable="True" Click="MenuRound_Click" />
                                        <MenuItem x:Name="MenuSquare" Style="{StaticResource PopupMenuItem}"
                                                  Header="直角气泡" IsCheckable="True" Click="MenuSquare_Click" />
                                        <Separator Style="{StaticResource PopupMenuSeparator}" />
                                        <MenuItem x:Name="MenuLight" Style="{StaticResource PopupMenuItem}"
                                                  Header="浅色主题" IsCheckable="True" Click="MenuLight_Click" />
                                        <MenuItem x:Name="MenuDark" Style="{StaticResource PopupMenuItem}"
                                                  Header="深色主题" IsCheckable="True" Click="MenuDark_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Height="52" FontSize="11"
                                    Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click" />
                            <Button Style="{StaticResource WindowButton}" Height="52" FontSize="11"
                                    Content="&#xE922;" ToolTip="最大化" Click="Maximize_Click" />
                            <Button Style="{StaticResource CloseWindowButton}" Height="52" FontSize="11"
                                    Content="&#xE8BB;" ToolTip="关闭" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyPane" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                   HorizontalAlignment="Center" Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextMuted}" Opacity="0.5" />
                        <TextBlock x:Name="EmptyTitle" Text="选择一个会话" FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock x:Name="EmptyHint" Text="左侧列表里的群聊与好友都能直接打开" FontSize="12"
                                   Margin="0,7,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>

                    <!-- 聊天 -->
                    <Grid x:Name="ChatPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 消息 -->
                        <ScrollViewer x:Name="MessageScroll" Grid.Row="0"
                                      Style="{StaticResource ThinScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0"
                                      ScrollChanged="MessageScroll_ScrollChanged">
                            <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}"
                                          Margin="18,10,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- 时间分隔：官方 0dp 直角灰块 -->
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource TimeChip}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowTimeHeader}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TimeHeaderText}" FontSize="11"
                                                           Foreground="{DynamicResource TimeChipText}" />
                                            </Border>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 对方头像：群聊显示，私聊按官方不显示 -->
                                                <controls:AvatarImage Grid.Column="0" Width="36" Height="36"
                                                                      VerticalAlignment="Top" Margin="0,1,8,0"
                                                                      Url="{Binding AvatarUrl}"
                                                                      FallbackText="{Binding SenderName}"
                                                                      Visibility="{Binding ShowPeerAvatar, Converter={StaticResource BoolToVisibility}}" />

                                                <StackPanel x:Name="MsgBody" Grid.Column="1">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock x:Name="SenderLabel" Text="{Binding SenderName}"
                                                               FontSize="12" Margin="1,0,0,3">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                                <Setter Property="Foreground" Value="{Binding SenderName, Converter={StaticResource NicknameBrush}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSenderName}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- 气泡 -->
                                                    <Border x:Name="Bubble">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource BubbleInStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BubbleOutBg}" />
                                                                        <Setter Property="CornerRadius" Value="{DynamicResource BubbleOutCorner}" />
                                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Border x:Name="QuoteBlock" Margin="0,0,0,6"
                                                                    Background="{DynamicResource ReplyBg}"
                                                                    Padding="6"
                                                                    Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{DynamicResource ReplyAccent}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding QuoteText}"
                                                                               FontSize="12" Margin="7,0,0,0"
                                                                               TextWrapping="Wrap" MaxHeight="60"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource ReplyText}" />
                                                                </Grid>
                                                            </Border>

                                                            <TextBlock x:Name="BodyText" Text="{Binding DisplayText}"
                                                                       TextWrapping="Wrap" FontSize="16"
                                                                       LineHeight="23" LineStackingStrategy="BlockLineHeight">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BubbleInText}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BubbleOutText}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Margin="1,4,0,0"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>

                                                <!-- 自己的头像：群聊显示在右侧 -->
                                                <controls:AvatarImage Grid.Column="2" Width="36" Height="36"
                                                                      VerticalAlignment="Top" Margin="8,1,0,0"
                                                                      Url="{Binding AvatarUrl}"
                                                                      FallbackText="{Binding SenderName}"
                                                                      Visibility="{Binding ShowMyAvatar, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 输入区：官方为无边框输入 + 裸箭头发送 -->
                        <Border Grid.Row="1" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="Composer"
                                             Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="44" MaxHeight="140"
                                             Padding="8,11" FontSize="15"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}"
                                             CaretBrush="{DynamicResource TextPrimary}"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="Composer_PreviewKeyDown" />
                                    <TextBlock x:Name="ComposerHint" Text="输入消息..."
                                               FontSize="15" Margin="10,12,0,0"
                                               VerticalAlignment="Top" IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ComposerText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="36" Height="40"
                                        Content="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                        Foreground="{DynamicResource TextSecondary}" ToolTip="更多" />

                                <Button Grid.Column="2" x:Name="SendButton" Style="{StaticResource GhostButton}"
                                        Content="&#xE724;" FontFamily="{StaticResource IconFont}"
                                        FontSize="16" Width="40" Height="40"
                                        Foreground="{DynamicResource AccentBrush}" ToolTip="发送"
                                        Click="Send_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
