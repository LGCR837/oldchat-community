<Window x:Class="OldChat.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OldChat.App.Controls"
        Title="旧聊" Height="740" Width="1160" MinHeight="580" MinWidth="920"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="旧聊" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="10,0,0,0"
                             Fill="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConnectionText" Text="连接中" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}" FontFamily="{StaticResource IconFont}"
                            FontSize="13" Content="&#xE793;" ToolTip="切换主题" Click="Theme_Click" />
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click" />
                    <Button Style="{StaticResource WindowButton}" Content="&#xE922;" ToolTip="最大化" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" ToolTip="关闭" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="304" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 导航栏 -->
                <Border Grid.Column="0" Background="{DynamicResource RailBg}">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                            <RadioButton x:Name="TabMessages" Style="{StaticResource RailButton}"
                                         GroupName="Rail" IsChecked="True" Content="&#xE8BD;"
                                         HorizontalAlignment="Center" ToolTip="消息"
                                         Click="TabMessages_Click" />
                            <RadioButton x:Name="TabFriends" Style="{StaticResource RailButton}"
                                         GroupName="Rail" Content="&#xE716;"
                                         HorizontalAlignment="Center" ToolTip="好友" Margin="0,2,0,0"
                                         Click="TabFriends_Click" />
                            <RadioButton x:Name="TabDiscover" Style="{StaticResource RailButton}"
                                         GroupName="Rail" Content="&#xE721;"
                                         HorizontalAlignment="Center" ToolTip="发现" Margin="0,2,0,0"
                                         Click="TabDiscover_Click" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,14">
                            <controls:AvatarImage x:Name="SelfAvatar" Width="30" Height="30"
                                                  HorizontalAlignment="Center"
                                                  ToolTip="我的" MouseLeftButtonUp="SelfAvatar_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 会话列表 -->
                <Border Grid.Column="1" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,12,12,8">
                            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="28,6,10,6" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <ListBox x:Name="ConversationList" Grid.Row="1"
                                 ItemsSource="{Binding ConversationsView}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <controls:AvatarImage Grid.Column="0" Width="40" Height="40"
                                                              Url="{Binding AvatarUrl}"
                                                              FallbackText="{Binding Title}"
                                                              IsOnline="{Binding IsOnline}"
                                                              ShowOnline="True" />

                                        <StackPanel Grid.Column="1" Margin="11,1,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <Border Style="{StaticResource UnreadBadge}" Margin="0,5,0,0"
                                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Unread}" FontSize="10"
                                                           Foreground="{DynamicResource BadgeText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Padding="14,7"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding StatusLine}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMuted}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 聊天区 -->
                <Grid Grid.Column="2" Background="{DynamicResource ChatBg}">

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyPane" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                   HorizontalAlignment="Center" Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextMuted}" Opacity="0.5" />
                        <TextBlock x:Name="EmptyTitle" Text="选择一个会话" FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock x:Name="EmptyHint" Text="左侧列表里的群聊与好友都能直接打开" FontSize="12"
                                   Margin="0,7,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>

                    <!-- 聊天 -->
                    <Grid x:Name="ChatPane" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 头部 -->
                        <Border Grid.Row="0" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <Grid Margin="18,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:AvatarImage Width="32" Height="32"
                                                          Url="{Binding Selected.AvatarUrl}"
                                                          FallbackText="{Binding Selected.Title}"
                                                          IsOnline="{Binding Selected.IsOnline}" />
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeaderTitle}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 消息 -->
                        <ScrollViewer x:Name="MessageScroll" Grid.Row="1"
                                      Style="{StaticResource ThinScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0"
                                      ScrollChanged="MessageScroll_ScrollChanged">
                            <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}"
                                          Margin="22,6,14,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- 时间分隔 -->
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource TimeChip}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowTimeHeader}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TimeHeaderText}" FontSize="11"
                                                           Foreground="{DynamicResource TimeChipText}" />
                                            </Border>

                                            <Grid x:Name="MsgRoot" Margin="0,0,0,10" Opacity="0">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="Trans" Y="6" />
                                                </Grid.RenderTransform>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <controls:AvatarImage x:Name="MsgAvatar" Grid.Column="0"
                                                                      Width="34" Height="34"
                                                                      VerticalAlignment="Top" Margin="0,1,0,0"
                                                                      Url="{Binding AvatarUrl}"
                                                                      FallbackText="{Binding AvatarLetter}" />

                                                <StackPanel x:Name="MsgBody" Grid.Column="1" Margin="10,0,0,0"
                                                            HorizontalAlignment="Left">
                                                    <!-- 昵称 -->
                                                    <TextBlock x:Name="SenderLabel" Text="{Binding SenderName}"
                                                               FontSize="12" Margin="1,0,0,4"
                                                               Foreground="{Binding SenderName, Converter={StaticResource Nickname}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSenderName}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- 气泡 -->
                                                    <Border x:Name="Bubble" Style="{StaticResource BubbleInStyle}">
                                                        <StackPanel>
                                                            <!-- 引用 -->
                                                            <Border x:Name="QuoteBlock" Margin="0,0,0,7"
                                                                    Background="{DynamicResource ReplyBg}"
                                                                    Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{DynamicResource ReplyAccent}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding QuoteText}"
                                                                               FontSize="12" Margin="8,5,8,6"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource ReplyText}" />
                                                                </Grid>
                                                            </Border>

                                                            <TextBlock x:Name="BodyText" Text="{Binding DisplayText}"
                                                                       TextWrapping="Wrap" FontSize="14"
                                                                       LineHeight="21"
                                                                       Foreground="{DynamicResource BubbleInText}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Margin="1,4,0,0"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <DataTemplate.Triggers>
                                            <!-- 自己的消息：右对齐、无头像、黑底 -->
                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                <Setter TargetName="MsgAvatar" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="MsgBody" Property="HorizontalAlignment" Value="Right" />
                                                <Setter TargetName="MsgBody" Property="Margin" Value="0" />
                                                <Setter TargetName="SenderLabel" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource BubbleOutBg}" />
                                                <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                                                <Setter TargetName="BodyText" Property="Foreground" Value="{DynamicResource BubbleOutText}" />
                                                <Setter TargetName="BodyText" Property="TextOptions.TextFormattingMode" Value="Display" />
                                            </DataTrigger>

                                            <!-- 入场：淡入 + 上浮 6px -->
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="MsgRoot"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="Trans"
                                                                         Storyboard.TargetProperty="Y"
                                                                         From="6" To="0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 输入区 -->
                        <Border Grid.Row="2" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource InputBg}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                                    <TextBox x:Name="Composer"
                                             Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="36" MaxHeight="130"
                                             Padding="11,8" FontSize="14"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}"
                                             CaretBrush="{DynamicResource TextPrimary}"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="Composer_PreviewKeyDown" />
                                </Border>

                                <Button Grid.Column="1" x:Name="SendButton" Style="{StaticResource PrimaryButton}"
                                        Content="发送" Width="78" Height="36" Margin="10,0,0,0"
                                        Click="Send_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
