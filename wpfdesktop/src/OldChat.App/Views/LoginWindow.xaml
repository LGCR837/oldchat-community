<Window x:Class="OldChat.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="旧聊" Height="592" Width="424"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

    <Window.Triggers>
        <!-- 打开：内容淡入并上浮 8px，200ms（PCL2 的出场手感） -->
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Form" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="FormTrans" Storyboard.TargetProperty="Y"
                                     From="8" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题条 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="旧聊" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}"
                        Content="&#xE8BB;" HorizontalAlignment="Right"
                        Height="30" Width="44" Click="Close_Click" />
            </Grid>

            <!-- 表单 -->
            <StackPanel x:Name="Form" Grid.Row="1" Margin="40,4,40,0" Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="FormTrans" Y="8" />
                </StackPanel.RenderTransform>

                <TextBlock Text="旧聊" FontSize="27" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="社区版桌面客户端" FontSize="12" Margin="0,7,0,0"
                           Foreground="{DynamicResource TextMuted}" />

                <TextBlock Text="服务器" Style="{StaticResource SectionText}" Margin="0,34,0,7" />
                <TextBox x:Name="OriginBox" Style="{StaticResource InputBox}" Height="36" />

                <TextBlock Text="账号" Style="{StaticResource SectionText}" Margin="0,16,0,7" />
                <TextBox x:Name="AccountBox" Style="{StaticResource InputBox}" Height="36" />

                <TextBlock Text="密码" Style="{StaticResource SectionText}" Margin="0,16,0,7" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordBoxStyle}"
                             Height="36" KeyDown="Password_KeyDown" />

                <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Margin="0,14,0,0" Visibility="Collapsed" />

                <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="登录"
                        Margin="0,26,0,0" Height="40" Click="Login_Click" />

                <TextBlock x:Name="StatusText" FontSize="11" Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
