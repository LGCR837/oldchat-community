<?xml version="1.0" encoding="utf-8"?>
<com.im.oldchat.ui.widget.ActionPanelAnimatedLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="180dp"
    android:background="@color/colorBackground"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:orientation="vertical"
    android:visibility="gone">

    <ScrollView
        android:id="@+id/action_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.im.oldchat.ui.widget.DiscoverTileLayout
                android:id="@+id/chatActionTileGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="action_tools_container"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <com.im.oldchat.ui.widget.TiltFrameLayout
                    android:id="@+id/btnActionImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.im.oldchat.ui.widget.TiltFrameLayout
                    android:id="@+id/btnActionVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.im.oldchat.ui.widget.TiltFrameLayout
                    android:id="@+id/btnActionRedPacket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.im.oldchat.ui.widget.TiltFrameLayout
                    android:id="@+id/btnActionBurn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.im.oldchat.ui.widget.DiscoverTileLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:tag="action_emoji_panel_container"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:tag="action_emoji_categories" />
                </HorizontalScrollView>

                <GridView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:horizontalSpacing="4dp"
                    android:listSelector="@android:color/transparent"
                    android:numColumns="auto_fit"
                    android:columnWidth="56dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="2dp"
                    android:stretchMode="columnWidth"
                    android:tag="action_emoji_grid"
                    android:verticalSpacing="4dp" />
            </LinearLayout>

            <com.im.oldchat.ui.widget.DiscoverTileLayout
                android:id="@+id/chatFileTileGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="action_file_panel_container"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <com.im.oldchat.ui.widget.TiltFrameLayout
                    android:id="@+id/btnFileLosslessImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.im.oldchat.ui.widget.TiltFrameLayout
                    android:id="@+id/btnFileLosslessVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.im.oldchat.ui.widget.TiltFrameLayout
                    android:id="@+id/btnFileSendDoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.im.oldchat.ui.widget.DiscoverTileLayout>

        </FrameLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/color_divider" />

    <LinearLayout
        android:id="@+id/action_bottom_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:tag="action_bottom_tab_bar">

        <LinearLayout
            android:id="@+id/tabActionTools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_transparent_row"
            android:tag="tab_action_tools">

            <ImageView
                android:id="@+id/ivTabToolsIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_action_image" />

            <TextView
                android:id="@+id/tvTabToolsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="功能"
                android:textSize="10sp"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabActionEmoji"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_transparent_row"
            android:tag="tab_action_emoji">

            <ImageView
                android:id="@+id/ivTabEmojiIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_action_emoji" />

            <TextView
                android:id="@+id/tvTabEmojiLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="表情"
                android:textSize="10sp"
                android:textColor="@color/colorTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabActionFile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_transparent_row"
            android:tag="tab_action_file">

            <ImageView
                android:id="@+id/ivTabFileIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_document" />

            <TextView
                android:id="@+id/tvTabFileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="文件"
                android:textSize="10sp"
                android:textColor="@color/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>
</com.im.oldchat.ui.widget.ActionPanelAnimatedLayout>
