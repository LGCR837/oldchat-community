<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:background="@color/color_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="10dp" android:paddingRight="14dp">
        <ImageView android:id="@+id/btnLuaBack" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:tint="@color/color_text_primary" android:src="@drawable/ic_nav_back" />
        <TextView android:id="@+id/tvLuaTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/color_text_primary" android:textSize="18sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/pbLuaLoading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/luaPageContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
    </ScrollView>
</LinearLayout>
