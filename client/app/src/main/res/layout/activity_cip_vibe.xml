<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:background="@color/color_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
        <ImageView android:id="@+id/btnVibeBack" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_nav_back" android:tint="@color/color_text_primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VibeCoding" android:textColor="@color/color_text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="持续代理 · 自动编码与测试" android:textColor="@color/color_text_secondary" android:textSize="10sp" />
        </LinearLayout>
        <Button android:id="@+id/btnVibeConfig" android:layout_width="wrap_content" android:layout_height="40dp" android:text="配置" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/tvVibeStatus" android:layout_width="match_parent" android:layout_height="28dp" android:background="#171A20" android:gravity="center_vertical" android:paddingLeft="12dp" android:text="就绪" android:textColor="#AFC8D5" android:textSize="11sp" />
    <ScrollView android:id="@+id/scrollVibe" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/tvVibeTasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_quote_telegram" android:padding="8dp" android:textColor="@color/color_text_secondary" android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/tvVibeToolStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="#17231F" android:typeface="monospace" android:lineSpacingExtra="2dp" android:padding="9dp" android:textColor="#80CBC4" android:textIsSelectable="true" android:textSize="11sp" android:visibility="gone" />
            <TextView android:id="@+id/tvVibeError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="#2A1719" android:padding="10dp" android:textColor="#FFAB91" android:textIsSelectable="true" android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/tvVibeTranscript" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:textColor="@color/color_text_primary" android:textSize="14sp" android:textIsSelectable="true" />
            <TextView android:id="@+id/btnVibeThinkingToggle" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp" android:background="#171F29" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="思考过程（已折叠，点击展开）" android:textColor="#AFC8D5" android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/tvVibeThinking" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#121820" android:ellipsize="end" android:maxLines="5" android:padding="8dp" android:textColor="#8299A6" android:textSize="12sp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="46dp" android:background="@color/color_surface" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="6dp" android:paddingRight="6dp">
            <Button android:id="@+id/btnVibeTest" android:layout_width="wrap_content" android:layout_height="40dp" android:text="运行测试" android:textSize="11sp" />
            <Button android:id="@+id/btnVibePreview" android:layout_width="wrap_content" android:layout_height="40dp" android:text="运行预览" android:textSize="11sp" />
            <Button android:id="@+id/btnVibeExport" android:layout_width="wrap_content" android:layout_height="40dp" android:text="导出 ZIP" android:textSize="11sp" />
            <Button android:id="@+id/btnVibeClear" android:layout_width="wrap_content" android:layout_height="40dp" android:text="清空对话" android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/color_surface" android:gravity="bottom" android:orientation="horizontal" android:padding="8dp">
        <EditText android:id="@+id/etVibeInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="描述你想开发的 CIP 应用…" android:maxLines="5" android:minHeight="44dp" android:padding="8dp" android:textColor="@color/color_text_primary" android:textColorHint="@color/color_text_secondary" android:textSize="14sp" />
        <Button android:id="@+id/btnVibeSend" android:layout_width="72dp" android:layout_height="44dp" android:layout_marginLeft="6dp" android:text="发送" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
