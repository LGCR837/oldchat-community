<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rlMusicPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_player_page_bg">

    <!-- 氛围动态背景（随封面取色） -->
    <com.im.oldchat.ui.widget.CoverAmbientMotionView
        android:id="@+id/view_cover_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部导航栏 -->
    <RelativeLayout
        android:id="@+id/layoutMusicPlayerTopbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/btnMusicPlayerBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_music_player_control_surface"
            android:contentDescription="@string/music_player_back"
            android:padding="10dp"
            android:src="@drawable/ic_nav_back" />

        <TextView
            android:id="@+id/tvMusicPlayerStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/music_player_ready"
            android:textColor="@color/music_player_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnMusicPlayerDownload"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_music_player_control_primary_themed"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/music_player_download"
            android:textColor="@color/color_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 圆形封面 -->
    <com.im.oldchat.ui.widget.CircleImageView
        android:id="@+id/ivMusicPlayerCover"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_below="@id/layoutMusicPlayerTopbar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder" />

    <!-- 封面信息区域 -->
    <LinearLayout
        android:id="@+id/llMusicPlayerCoverInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivMusicPlayerCover"
        android:layout_above="@id/llMusicPlayerControls"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <TextView
            android:id="@+id/tvMusicPlayerSongName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/music_player_song_name"
            android:textColor="@color/music_player_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMusicPlayerOwner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/music_player_owner"
            android:textColor="@color/music_player_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMusicPlayerStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/music_player_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMusicPlayerSwipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/music_player_swipe_hint"
            android:textColor="@color/music_player_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 歌词页标题栏 -->
    <LinearLayout
        android:id="@+id/llMusicPlayerLyricHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="64dp"
        android:layout_marginLeft="72dp"
        android:layout_marginRight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMusicPlayerLyricTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/music_player_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMusicPlayerLyricArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/music_player_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 级联歌词 -->
    <com.im.oldchat.ui.widget.LyricCascadeView
        android:id="@+id/view_music_player_lyric"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llMusicPlayerLyricHeader"
        android:layout_above="@id/llMusicPlayerControls"
        android:visibility="invisible" />

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/llMusicPlayerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <SeekBar
            android:id="@+id/sbMusicPlayerProgress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:progressDrawable="@drawable/bg_music_player_seekbar_themed"
            android:splitTrack="false"
            android:thumb="@drawable/bg_music_player_seekbar_thumb_new"
            android:thumbOffset="0dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvMusicPlayerCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:text="00:00"
                android:textColor="@color/music_player_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMusicPlayerDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="00:00"
                android:textColor="@color/music_player_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 按钮行：按钮之间用弹性间隔（weight）填充，小屏/高 DPI 下间距自动压缩，按钮永不溢出屏幕。
             权重比例 3:6:6:4 对应原固定间距 12:24:24:16dp，正常屏观感不变。
             兼容 Android 2.3：使用 View 而非 Space（Space 为 API 14+）。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMusicPlayerMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/music_player_more"
                android:padding="13dp"
                android:src="@drawable/ic_more_three_dots" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="3" />

            <com.im.oldchat.ui.widget.FontAwesomeTextView
                android:id="@+id/btnMusicPlayerRepeatOne"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/music_player_repeat_one"
                android:gravity="center"
                android:text="&#xf01e;"
                android:textColor="@color/music_player_text_primary"
                android:textSize="18sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="6" />

            <ImageView
                android:id="@+id/btnMusicPlayerPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_music_player_play_btn"
                android:contentDescription="@string/music_player_play"
                android:padding="20dp"
                android:src="@android:drawable/ic_media_play" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="6" />

            <ImageView
                android:id="@+id/btnMusicPlayerComments"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/music_player_comments"
                android:padding="10dp"
                android:src="@drawable/ic_comment" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="4" />

            <TextView
                android:id="@+id/btnMusicPlayerLike"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#9825;"
                android:textColor="@color/music_player_text_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
