<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="服务器与 OSS 资源均为各路人员捐赠 + 开发者自己贡献而来。\n此项目几乎无法盈利，纯为爱发电，如果您有多余资金可以支持项目开发。\n并且 Oldchat API 完全公开，您可以构建您自己的客户端，并且服务完全免费，如若有资金请支持官方开发。"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:padding="10dp">

            <ImageView
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="支付宝捐赠二维码"
                android:scaleType="fitCenter"
                android:src="@drawable/alipay_donate_qr" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="支付宝扫码捐赠"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:padding="10dp">

            <ImageView
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="微信捐赠二维码"
                android:scaleType="fitCenter"
                android:src="@drawable/donate_wechat_qr" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="微信扫码捐赠"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="- The Team of Oldchat -\n- Oldchat Devs -\n- Oldchat Users -\n-- Love from Oldchat --"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
