<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="14dp">
        <ImageView android:id="@+id/btnMiniAppsBack" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_nav_back" android:tint="@color/color_text_primary" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:layout_weight="1" android:text="小程序" android:textColor="@color/color_text_primary" android:textSize="18sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/pbMiniAppsSync" android:layout_width="22dp" android:layout_height="22dp" android:visibility="gone" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnMiniAppsStore" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="小程序商店" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" />
                <Button android:id="@+id/btnMiniAppsImport" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginLeft="6dp" android:layout_weight="1" android:text="导入本地包" android:textAllCaps="false" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <Button android:id="@+id/btnMiniAppsDevelop" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="开发模式" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btnMiniAppsDocs" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:layout_weight="1" android:text="开发文档" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="已安装小程序" android:textColor="@color/color_text_secondary" android:textSize="12sp" />
            <LinearLayout android:id="@+id/miniAppsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/tvMiniAppsEmpty" android:layout_width="match_parent" android:layout_height="100dp" android:gravity="center" android:text="暂无小程序" android:textColor="@color/color_text_secondary" android:textSize="14sp" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="长按本地小程序可删除" android:textColor="@color/color_text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
