<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@+id/btnEmojiPlazaBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="返回"
            android:padding="11dp"
            android:src="@drawable/ic_nav_back" />

        <EditText
            android:id="@+id/etEmojiPlazaKeyword"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:hint="搜索表情包"
            android:imeOptions="actionSearch"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/btnEmojiPlazaSearch"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@color/color_on_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:text="搜索结果可预览、收藏或添加到我的表情"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_list_item_surface">

        <ListView
            android:id="@+id/lvEmojiPlaza"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvEmojiPlazaEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="输入关键词搜索表情包"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutEmojiPlazaPager"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <TextView
            android:id="@+id/tvEmojiPlazaPageInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnEmojiPlazaPrev"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:background="@drawable/flat_button_bg"
            android:gravity="center"
            android:text="上一页"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnEmojiPlazaNext"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/flat_button_bg"
            android:gravity="center"
            android:text="下一页"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
