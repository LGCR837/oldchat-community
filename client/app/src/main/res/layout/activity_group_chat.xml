<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout 
        android:id="@+id/group_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/color_surface">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="4dp">

            <com.im.oldchat.ui.widget.FontAwesomeTextView
                android:id="@+id/btnGroupChatBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:background="@drawable/bg_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@null"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="&#xf060;"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp" />

            <View
                android:id="@+id/vBackDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="right|top"
                android:layout_marginRight="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_unread_dot"
                android:visibility="gone" />
        </FrameLayout>

        <com.im.oldchat.ui.widget.CircleImageView
            android:id="@+id/ivGroupAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/group" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGroupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="群聊"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llChatConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/vChatConnectionDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_chat_state_white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvChatConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnGroupManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="管理"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_icon_btn" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbMessagesLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/group_header"
        android:indeterminate="true"
        android:visibility="gone" />

    

    <LinearLayout
        android:id="@+id/group_announcement_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/pbMessagesLoading"
        android:background="@color/colorChatTipBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGroupAnnouncementBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorChatTipText"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout 
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/color_surface">

        <LinearLayout
            android:id="@+id/forward_multi_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:background="@color/color_surface"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvForwardMultiCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnForwardMultiCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="@string/forward_multi_cancel"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnForwardMultiSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="@string/message_action_forward"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/quote_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_quote_telegram"
            android:visibility="gone">

            <View
                android:id="@+id/vQuotePreviewLine"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginRight="8dp"
                android:background="@color/colorReplyHighlight" />

            <TextView
                android:id="@+id/tvQuotePreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnQuoteClose"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="8dp"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/input_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@color/color_surface">

            <ImageView
                android:id="@+id/btnToggleVoice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:padding="4dp"
                app:srcCompat="@drawable/chatting_setmode_voice_btn_normal" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp">

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical|left"
                    android:hint="输入群消息..."
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minHeight="44dp"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/tvCharCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="10sp"
                    android:textColor="@color/colorTextSecondary"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnHoldToTalk"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:gravity="center"
                android:text="按住说话"
                android:textColor="@color/color_text_primary"
                android:background="@null"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnPlus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="8dp"
                android:background="@null"
                android:padding="4dp"
                app:srcCompat="@drawable/icon_chat_plus" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="6dp"
                android:background="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="➤"
                android:textColor="?attr/colorAccent"
                android:textSize="17sp"
                android:includeFontPadding="false" />

            <ProgressBar
                android:id="@+id/pbSend"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="8dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/video_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_s"
            android:paddingRight="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvVideoProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbVideoProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:max="100"
                android:visibility="gone" />
        </LinearLayout>

        <ViewStub
            android:id="@+id/stub_action_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inflatedId="@+id/action_panel"
            android:layout="@layout/layout_chat_action_panel" />

    </LinearLayout>
    <ImageView
        android:id="@+id/chat_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/group_announcement_banner"
        android:layout_above="@id/input_container"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <com.im.oldchat.ui.GroupMessageRecyclerView
        android:id="@+id/lvMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/group_announcement_banner"
        android:layout_above="@id/input_container"
        android:overScrollMode="never"
        android:padding="8dp" />

    <TextView
        android:id="@+id/btnJumpToUnread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnNewMessage"
        android:layout_alignParentRight="true"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_new_message_bubble"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="跳到未读"
        android:textColor="@color/color_on_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnNewMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/input_container"
        android:layout_alignParentRight="true"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_new_message_bubble"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="新消息"
        android:textColor="@color/color_on_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/chat_open_loading_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/group_announcement_banner"
        android:layout_above="@id/input_container"
        android:background="@color/color_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="20dp"
            android:paddingRight="24dp"
            android:paddingBottom="20dp">

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在打开群聊..."
                android:textColor="@color/color_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
