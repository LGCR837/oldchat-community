<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="8dp"
        android:orientation="horizontal"
        android:background="#FFFFFF">
        <TextView
            android:id="@+id/btnChannelBack"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textSize="34sp"
            android:textColor="#168ACD" />
        <com.im.oldchat.ui.widget.CircleImageView
            android:id="@+id/ivChannelAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/group" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvChannelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#17212B" />
            <TextView
                android:id="@+id/tvChannelSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="13sp"
                android:textColor="#7A8A99" />
        </LinearLayout>
        <TextView
            android:id="@+id/btnChannelMore"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textSize="28sp"
            android:textColor="#596875" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/listChannelPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:clipToPadding="false"
            android:listSelector="@android:color/transparent"
            android:background="#FFFFFF" />
        <TextView
            android:id="@+id/tvChannelEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:text="No posts yet"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_channel_empty" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#FFFFFF">
        <TextView
            android:id="@+id/tvChannelMute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MUTE"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#168ACD" />
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#E3E8EC" />
        <TextView
            android:id="@+id/tvChannelShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SHARE"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#168ACD" />
        <View
            android:id="@+id/dividerChannelPost"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#E3E8EC"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvChannelPost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="POST"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#168ACD"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
