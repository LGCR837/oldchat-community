<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="12dp">
        <ImageView
            android:id="@+id/btnCipBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/color_text_primary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="CIP 开发器"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvCipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="就绪"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/color_surface"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/cipFileList"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvCipCurrentFile"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#171A20"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:text="main.lua"
        android:textColor="#AFC8D5"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="#101216"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvCipLineNumbers"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="#171A20"
                android:gravity="right"
                android:paddingLeft="4dp"
                android:paddingTop="10dp"
                android:paddingRight="8dp"
                android:textColor="#65727B"
                android:textSize="14sp"
                android:typeface="monospace" />
            <EditText
                android:id="@+id/etCipCode"
                android:layout_width="640dp"
                android:layout_height="match_parent"
                android:background="#101216"
                android:gravity="top|left"
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:saveEnabled="false"
                android:freezesText="false"
                android:textColor="#E7EDF0"
                android:textColorHighlight="#506FACC9"
                android:textSize="14sp"
                android:typeface="monospace" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/color_surface"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">
            <Button android:id="@+id/btnCipNew" android:layout_width="wrap_content" android:layout_height="42dp" android:text="新建" android:textSize="12sp" />
            <Button android:id="@+id/btnCipSave" android:layout_width="wrap_content" android:layout_height="42dp" android:text="保存" android:textSize="12sp" />
            <Button android:id="@+id/btnCipDelete" android:layout_width="wrap_content" android:layout_height="42dp" android:text="删除" android:textSize="12sp" />
            <Button android:id="@+id/btnCipTest" android:layout_width="wrap_content" android:layout_height="42dp" android:text="运行测试" android:textSize="12sp" />
            <Button android:id="@+id/btnCipPreview" android:layout_width="wrap_content" android:layout_height="42dp" android:text="运行预览" android:textSize="12sp" />
            <Button android:id="@+id/btnCipPackage" android:layout_width="wrap_content" android:layout_height="42dp" android:text="打包 ZIP" android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
