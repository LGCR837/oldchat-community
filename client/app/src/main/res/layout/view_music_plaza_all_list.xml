<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:background="@drawable/bg_list_item_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="全部歌曲"
        android:textColor="@color/music_plaza_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="把完整曲库都放在这里，慢慢翻也更顺手。"
        android:textColor="@color/music_plaza_text_secondary"
        android:textSize="11sp" />

    <HorizontalScrollView
        android:id="@+id/layoutMusicPlazaLegacyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMusicPlazaFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_music_plaza_tag_positive"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="全部歌曲"
                android:textColor="@color/music_plaza_chip_accent_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMusicPlazaFilterMine"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_music_plaza_tag_neutral"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="我的上传"
                android:textColor="@color/music_plaza_text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnMusicPlazaMineManage"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_profile_item"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="管理上传"
                android:textColor="@color/music_plaza_text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMusicPlazaPageInfo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_music_plaza_stat_chip"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/music_plaza_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnMusicPlazaPrev"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center"
            android:text="上一页"
            android:textColor="@color/music_plaza_text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnMusicPlazaNext"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center"
            android:text="下一页"
            android:textColor="@color/music_plaza_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvMusicPlaza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:cacheColorHint="#00000000"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent" />

    <TextView
        android:id="@+id/tvMusicPlazaEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_list_item_surface"
        android:gravity="center"
        android:padding="14dp"
        android:text="暂无歌曲"
        android:textColor="@color/music_plaza_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
