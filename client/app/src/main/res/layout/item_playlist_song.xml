<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_item_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivPlaylistSongCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_music_plaza_cover_frame"
        android:contentDescription="@null"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaylistSongName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/music_plaza_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlaylistSongOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/music_plaza_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnPlaylistSongDownload"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_profile_item"
        android:gravity="center"
        android:minWidth="52dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="下载"
        android:textColor="@color/music_plaza_text_primary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/btnPlaylistSongDelete"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/bg_music_player_control_primary_themed"
        android:gravity="center"
        android:minWidth="52dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="移除"
        android:textColor="@color/color_on_primary"
        android:textSize="11sp" />

</LinearLayout>
