<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_music_plaza_apple_section"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvMusicResultRank"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/bg_music_plaza_apple_meta_chip"
        android:gravity="center"
        android:text="01"
        android:textColor="@color/music_plaza_chip_accent_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_music_plaza_apple_cover_frame"
        android:padding="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/music_plaza_search_hint"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivMusicResultCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMusicResultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="歌曲名称"
            android:textColor="@color/music_plaza_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMusicResultOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="上传者 · 用户"
            android:textColor="@color/music_plaza_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMusicResultMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="时长未知 · 0 MB"
            android:textColor="@color/music_plaza_meta_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvMusicResultStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="播放 0 · 赞 0 · 评论 0"
            android:textColor="@color/music_plaza_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnMusicResultPlay"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_music_plaza_play_button"
            android:gravity="center"
            android:text="播放"
            android:textColor="@color/music_plaza_button_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMusicResultMore"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_music_plaza_apple_icon_button"
            android:gravity="center"
            android:text="更多"
            android:textColor="@color/music_plaza_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
