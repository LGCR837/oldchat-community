<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:background="@color/color_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="14dp">
        <ImageView android:id="@+id/btnCipModeBack" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_nav_back" android:tint="@color/color_text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:text="开发 CIP" android:textColor="@color/color_text_primary" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择开发模式" android:textColor="@color/color_text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="两种模式共用同一个 CIP 项目工作区" android:textColor="@color/color_text_secondary" android:textSize="13sp" />
        <Button android:id="@+id/btnCipIdeMode" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="24dp" android:text="IDE 模式\n代码编辑器与文件管理" android:textAllCaps="false" android:textSize="15sp" />
        <Button android:id="@+id/btnCipVibeMode" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:text="VibeCoding 模式\n与 AI 对话完成开发" android:textAllCaps="false" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
