<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3745" />
            <stroke
                android:width="1dp"
                android:color="#435768" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2A35" />
            <stroke
                android:width="1dp"
                android:color="#3A4C5B" />
        </shape>
    </item>
</selector>
