<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/button_corner_radius_compat" />
            <solid android:color="@color/music_player_control_bg_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/music_player_control_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/button_corner_radius_compat" />
            <solid android:color="@color/music_player_control_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/music_player_control_stroke" />
        </shape>
    </item>
</selector>
