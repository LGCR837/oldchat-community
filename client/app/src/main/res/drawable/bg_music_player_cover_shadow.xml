<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#20000000" />
        </shape>
    </item>
    <!-- 边框层 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/music_player_cover_stroke" />
        </shape>
    </item>
    <!-- 内容背景层 -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@color/music_player_cover_bg" />
        </shape>
    </item>
</layer-list>
