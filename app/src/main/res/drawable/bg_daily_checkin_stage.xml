<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:endColor="#FFF4E8"
                android:startColor="#FFFDF8" />
            <stroke
                android:width="1dp"
                android:color="@color/color_divider" />
        </shape>
    </item>
    <item android:left="14dp" android:top="14dp">
        <shape android:shape="oval">
            <size android:width="56dp" android:height="56dp" />
            <solid android:color="#1AF59E0B" />
        </shape>
    </item>
    <item android:right="18dp" android:bottom="24dp">
        <shape android:shape="oval">
            <size android:width="72dp" android:height="72dp" />
            <solid android:color="#14059669" />
        </shape>
    </item>
</layer-list>
