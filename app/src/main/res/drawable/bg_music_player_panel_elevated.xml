<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item android:left="0dp" android:top="1dp" android:right="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#10000000" />
        </shape>
    </item>
    <!-- 面板层 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/music_player_control_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/music_player_control_stroke" />
        </shape>
    </item>
</layer-list>
