<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#15000000" />
        </shape>
    </item>
    <!-- 主卡片层 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/music_player_card_shell_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/music_player_card_shell_stroke" />
        </shape>
    </item>
</layer-list>
