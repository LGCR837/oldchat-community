        <item name="colorPrimary">#D6B89A</item>
        <item name="colorPrimaryDark">#C49A6C</item>
        <item name="colorAccent">#D6B89A</item>
    </style>
    <style name="AppTheme.Brown.Round" parent="AppTheme.Brown">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <!-- 极简深色主题：黑灰为主，浅蓝仅作少量强调 -->
    <style name="AppTheme.Dark" parent="AppTheme">
        <item name="colorPrimary">#9CA3AF</item>
        <item name="colorPrimaryDark">#08090A</item>
        <item name="colorAccent">#9CA3AF</item>
    </style>
    <style name="AppTheme.Dark.Round" parent="AppTheme.Dark">
        <item name="buttonCornerRadius">10dp</item>
