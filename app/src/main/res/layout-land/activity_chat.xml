<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <android.support.v7.widget.Toolbar 
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/colorToolbar">

        <LinearLayout 
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true">

            <FrameLayout
                android:layout_width="@dimen/chat_header_control_size"
                android:layout_height="@dimen/chat_header_control_size"
                android:layout_marginLeft="4dp">

                <com.im.oldchat.ui.widget.FontAwesomeTextView
                    android:id="@+id/btnChatBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:background="@drawable/bg_icon_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@null"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="&#xf060;"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/vBackDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="right|top"
                    android:layout_marginRight="6dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_unread_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/chat_title_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/vChatConnectionDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_chat_state_white" />

                        <TextView
                            android:id="@+id/tvChatConnectionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="连接中"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnChatMenu"
                android:layout_width="@dimen/chat_header_control_size"
                android:layout_height="@dimen/chat_header_control_size"
                android:layout_marginRight="4dp"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_more_three_dots"
                android:contentDescription="@null" />
        </LinearLayout>
    </android.support.v7.widget.Toolbar>

    

    <FrameLayout 
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/pbMessagesLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/chat_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/lvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/space_m"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/btnJumpToUnread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="@dimen/space_s"
            android:layout_marginBottom="72dp"
            android:background="@drawable/bg_new_message_bubble"
            android:clickable="true"
            android:paddingLeft="@dimen/space_m"
            android:paddingRight="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:text="跳到未读"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnNewMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_l"
            android:background="@drawable/bg_new_message_bubble"
            android:clickable="true"
            android:paddingLeft="@dimen/space_m"
            android:paddingRight="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:text="新消息"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/chat_open_loading_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBackground"
            android:clickable="true"
            android:focusable="true"
        android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingTop="20dp"
                android:paddingRight="24dp"
                android:paddingBottom="20dp">

                <ProgressBar
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="正在打开聊天..."
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/forward_multi_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/space_s"
        android:paddingTop="@dimen/space_s"
        android:paddingRight="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        android:background="@color/colorToolbar"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvForwardMultiCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnForwardMultiCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingRight="@dimen/space_m"
            android:paddingBottom="@dimen/space_s"
            android:text="@string/forward_multi_cancel"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnForwardMultiSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_s"
            android:paddingLeft="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingRight="@dimen/space_m"
            android:paddingBottom="@dimen/space_s"
            android:text="@string/message_action_forward"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout 
        android:id="@+id/quote_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quote_telegram"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_s"
        android:visibility="gone">

        <View
            android:id="@+id/vQuotePreviewLine"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:background="@color/colorReplyHighlight" />

        <TextView
            android:id="@+id/tvQuotePreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btnQuoteClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="@dimen/space_s"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <LinearLayout 
        android:id="@+id/input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_s"
        android:background="@color/colorToolbar">

        <ImageView
            android:id="@+id/btnToggleVoice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@null"
            android:padding="4dp"
            app:srcCompat="@drawable/chatting_setmode_voice_btn_normal" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/space_s">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="输入消息..."
                android:inputType="textMultiLine"
                android:imeOptions="actionSend"
                android:singleLine="false"
                android:minHeight="44dp"
                android:maxLines="4"
                android:gravity="center_vertical|left"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:paddingLeft="@dimen/space_s"
                android:paddingTop="10dp"
                android:paddingRight="@dimen/space_m"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/tvCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="4dp"
                android:textSize="10sp"
                android:textColor="@color/colorTextSecondary"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnHoldToTalk"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/space_s"
            android:gravity="center"
            android:text="按住说话"
            android:textColor="@color/colorTextPrimary"
            android:background="@null"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="@dimen/space_s"
            android:background="@null"
            android:padding="4dp"
            app:srcCompat="@drawable/icon_chat_plus" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="6dp"
            android:background="@null"
            android:gravity="center"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textColor="?attr/colorAccent"
            android:textSize="17sp"
            android:includeFontPadding="false" />

        <ProgressBar
            android:id="@+id/pbSend"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/space_s"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/video_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_s"
        android:paddingRight="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvVideoProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pbVideoProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <com.im.oldchat.ui.widget.ActionPanelAnimatedLayout
        android:id="@+id/action_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        android:padding="@dimen/space_m"
        android:orientation="vertical"
        android:visibility="gone">

        <com.im.oldchat.ui.widget.DiscoverTileLayout
            android:id="@+id/chatActionTileGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="action_tools_container"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp">

            <com.im.oldchat.ui.widget.TiltFrameLayout
                android:id="@+id/btnActionImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.im.oldchat.ui.widget.TiltFrameLayout
                android:id="@+id/btnActionVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.im.oldchat.ui.widget.TiltFrameLayout
                android:id="@+id/btnActionRedPacket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.im.oldchat.ui.widget.TiltFrameLayout
                android:id="@+id/btnActionBurn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.im.oldchat.ui.widget.DiscoverTileLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="action_emoji_panel_container"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:tag="action_emoji_categories" />
            </HorizontalScrollView>

            <GridView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:clipToPadding="false"
                android:gravity="center"
                android:horizontalSpacing="6dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="5"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:stretchMode="columnWidth"
                android:tag="action_emoji_grid"
                android:verticalSpacing="6dp" />
        </LinearLayout>

        <com.im.oldchat.ui.widget.DiscoverTileLayout
            android:id="@+id/chatFileTileGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="action_file_panel_container"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <com.im.oldchat.ui.widget.TiltFrameLayout
                android:id="@+id/btnFileLosslessImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.im.oldchat.ui.widget.TiltFrameLayout
                android:id="@+id/btnFileLosslessVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.im.oldchat.ui.widget.TiltFrameLayout
                android:id="@+id/btnFileSendDoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.im.oldchat.ui.widget.DiscoverTileLayout>
    </com.im.oldchat.ui.widget.ActionPanelAnimatedLayout>

    </LinearLayout>

</LinearLayout>
