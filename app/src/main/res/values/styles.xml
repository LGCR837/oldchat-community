<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="buttonCornerRadius">0dp</item>
        <item name="chatBubbleCornerRadius">0dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:buttonStyle">@style/RoundedOutlineButton</item>
        <item name="buttonStyle">@style/RoundedOutlineButton</item>
        <item name="android:editTextStyle">@style/FlatInput</item>
        <item name="editTextStyle">@style/FlatInput</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
        <item name="android:windowAnimationStyle">@style/SquareWindowAnimation</item>
        <item name="switchStyle">@style/AppSwitch</item>
    </style>

    <!-- SwitchCompat 统一样式：只改开关滑轨/滑块关闭态颜色，打开态跟随 colorAccent（主题色），
         避免低版本默认 ?android:textColorSecondary 灰色块与自定义背景不协调。 -->
    <style name="AppSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="colorControlNormal">@color/switch_track_off</item>
        <item name="colorSwitchThumbNormal">@color/switch_thumb_off</item>
    </style>

    <!-- 开屏只使用 API 1 即存在的平台主题，避免 Android 2.3 在 Activity.onCreate 前
         解析 AppCompat DayNight 或 @null 窗口动画时失败。 -->
    <style name="SplashTheme" parent="android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Round" parent="AppTheme">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <style name="AppTheme.Green" parent="AppTheme">
        <item name="colorPrimary">#16A34A</item>
        <item name="colorPrimaryDark">#15803D</item>
        <item name="colorAccent">#16A34A</item>
    </style>
    <style name="AppTheme.Green.Round" parent="AppTheme.Green">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <style name="AppTheme.Blue" parent="AppTheme">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryDark">#1D4ED8</item>
        <item name="colorAccent">#2563EB</item>
    </style>
    <style name="AppTheme.Blue.Round" parent="AppTheme.Blue">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <style name="AppTheme.Orange" parent="AppTheme">
        <item name="colorPrimary">#EA580C</item>
        <item name="colorPrimaryDark">#C2410C</item>
        <item name="colorAccent">#EA580C</item>
    </style>
    <style name="AppTheme.Orange.Round" parent="AppTheme.Orange">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <style name="AppTheme.Red" parent="AppTheme">
        <item name="colorPrimary">#DC2626</item>
        <item name="colorPrimaryDark">#B91C1C</item>
        <item name="colorAccent">#DC2626</item>
    </style>
    <style name="AppTheme.Red.Round" parent="AppTheme.Red">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <style name="AppTheme.Teal" parent="AppTheme">
        <item name="colorPrimary">#0F766E</item>
        <item name="colorPrimaryDark">#115E59</item>
        <item name="colorAccent">#0F766E</item>
    </style>
    <style name="AppTheme.Teal.Round" parent="AppTheme.Teal">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <style name="AppTheme.Brown" parent="AppTheme">
        <item name="colorPrimary">#7C5A3A</item>
        <item name="colorPrimaryDark">#5B422A</item>
        <item name="colorAccent">#7C5A3A</item>
    </style>
    <style name="AppTheme.Brown.Round" parent="AppTheme.Brown">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <!-- 极简深色主题：黑灰为主，浅蓝仅作少量强调 -->
    <style name="AppTheme.Dark" parent="AppTheme">
        <item name="colorPrimary">#9CA3AF</item>
        <item name="colorPrimaryDark">#08090A</item>
        <item name="colorAccent">#9CA3AF</item>
    </style>
    <style name="AppTheme.Dark.Round" parent="AppTheme.Dark">
        <item name="buttonCornerRadius">10dp</item>
        <item name="chatBubbleCornerRadius">14dp</item>
        <item name="chatBubbleAvatarCornerRadius">0dp</item>
    </style>

    <style name="SquareWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/square_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/square_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/square_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/square_activity_close_exit</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/color_surface</item>
    </style>

    <style name="PopupMenuOverlayLight" parent="Theme.AppCompat.Light">
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
    </style>

    <style name="PopupMenuOverlayDark" parent="Theme.AppCompat">
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
    </style>

    <style name="RoundedOutlineButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_outline_primary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="TextLinkButton" parent="RoundedOutlineButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="FlatButton" parent="RoundedOutlineButton" />

    <style name="FlatButtonPrimary" parent="RoundedOutlineButton">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/color_on_primary</item>
    </style>

    <style name="ChatSendButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_chat_send_button</item>
        <item name="android:textColor">@color/chat_send_button_text</item>
        <item name="textAllCaps">false</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FlatButtonOutline" parent="RoundedOutlineButton" />

    <style name="FlatButtonDanger" parent="RoundedOutlineButton">
        <item name="android:background">@drawable/button_outline_danger</item>
        <item name="android:textColor">@color/colorDanger</item>
    </style>

    <style name="FlatInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/flat_input_bg</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
    </style>

    <style name="CrashDialogTheme" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppDialogTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:editTextStyle">@style/FlatInput</item>
    </style>

    <style name="AppAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
    </style>

    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
