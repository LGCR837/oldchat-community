<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_music_plaza_apple_section"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivRankingCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRankingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="歌曲名称"
            android:textColor="@color/music_plaza_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRankingOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="上传者 · 00:00"
            android:textColor="@color/music_plaza_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnRankingPlay"
        android:layout_width="46dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_music_plaza_play_button"
        android:gravity="center"
        android:text="播放"
        android:textColor="@color/music_plaza_button_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnRankingMore"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="6dp"
        android:background="@drawable/bg_music_plaza_apple_icon_button"
        android:gravity="center"
        android:text="···"
        android:textColor="@color/music_plaza_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
