<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <TextView
            android:id="@+id/btnMinimalNewsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="返回"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMinimalNewsTitleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="RSS 阅读器"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMinimalNewsSources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="订阅源"
            android:textColor="@color/color_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnMinimalNewsRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="刷新"
            android:textColor="@color/color_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_surface_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTabHot"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_minimal_news_tab_active"
            android:gravity="center"
            android:text="科技"
            android:textColor="@color/minimal_news_tab_active_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTabTech"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_minimal_news_tab_inactive"
            android:gravity="center"
            android:text="少数派"
            android:textColor="@color/minimal_news_tab_inactive_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTabFinance"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_minimal_news_tab_inactive"
            android:gravity="center"
            android:text="开发"
            android:textColor="@color/minimal_news_tab_inactive_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTabBlock"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_minimal_news_tab_inactive"
            android:gravity="center"
            android:text="国际"
            android:textColor="@color/minimal_news_tab_inactive_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMinimalNewsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:padding="12dp"
        android:text="加载中..."
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/lvMinimalNews"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fadingEdge="none"
        android:listSelector="@android:color/transparent"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp" />

</LinearLayout>
