<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_item_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="添加到歌单"
        android:textColor="@color/music_plaza_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvDialogPlaylists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:divider="@color/music_plaza_panel_stroke"
        android:dividerHeight="0.5dp"
        android:maxHeight="300dp" />

    <TextView
        android:id="@+id/btnDialogNewPlaylist"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_music_plaza_play_button"
        android:gravity="center"
        android:text="+ 新建歌单"
        android:textColor="@color/music_plaza_button_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDialogCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_profile_item"
        android:gravity="center"
        android:text="取消"
        android:textColor="@color/music_plaza_text_primary"
        android:textSize="13sp" />

</LinearLayout>
