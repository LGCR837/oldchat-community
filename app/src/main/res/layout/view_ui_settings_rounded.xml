<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowRoundedButtons"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_seamless_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@drawable/ic_setting_rounded" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="圆角按钮"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <android.support.v7.widget.SwitchCompat
            android:id="@+id/switchRoundedButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowBubbleRounded"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_seamless_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@drawable/ic_setting_bubble_out" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="圆角聊天气泡（关闭后为方角）"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <android.support.v7.widget.SwitchCompat
            android:id="@+id/switchBubbleRounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowSenderNameOutsideBubble"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_seamless_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@drawable/ic_setting_appearance" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="群聊名字显示在气泡外"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <android.support.v7.widget.SwitchCompat
            android:id="@+id/switchSenderNameOutsideBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowGroupColoredName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_seamless_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@drawable/ic_setting_theme_color" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="群聊彩色昵称"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <android.support.v7.widget.SwitchCompat
            android:id="@+id/switchGroupColoredName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowBubbleTimeNewLine"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_seamless_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@drawable/ic_setting_bubble_out" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="气泡时间换行显示"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <android.support.v7.widget.SwitchCompat
            android:id="@+id/switchBubbleTimeNewLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowButton3dEffect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_seamless_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@drawable/ic_setting_press_3d" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="3D按压动效"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <android.support.v7.widget.SwitchCompat
            android:id="@+id/switchButton3dEffect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowHideAvatar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_seamless_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@drawable/ic_setting_appearance" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="不显示头像"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <android.support.v7.widget.SwitchCompat
            android:id="@+id/switchHideAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
