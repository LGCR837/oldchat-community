<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:background="@drawable/bg_moments_cover_placeholder">

        <ImageView
            android:id="@+id/ivMomentsHeaderCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_moments_cover_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_moments_cover_mask" />

        <TextView
            android:id="@+id/tvMomentsHeaderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="104dp"
            android:layout_marginBottom="52dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="我"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMomentsHeaderSignature"
            android:tag="moments_header_signature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="104dp"
            android:layout_marginBottom="28dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <com.im.oldchat.ui.widget.RoundedImageView
            android:id="@+id/ivMomentsHeaderAvatar"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:cornerRadius="38dp"
            app:srcCompat="@drawable/ic_avatar_placeholder" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/color_surface" />

</LinearLayout>
