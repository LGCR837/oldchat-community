<?xml version="1.0" encoding="utf-8"?>
<com.im.oldchat.ui.widget.TiltFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/classicRowSurface"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_friend_row_native"
        android:duplicateParentState="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <FrameLayout
            android:id="@+id/flClassicAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">

            <com.im.oldchat.ui.widget.RoundedImageView
                android:id="@+id/ivPastelAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:cornerRadius="23dp"
                app:srcCompat="@drawable/ic_avatar_placeholder" />

            <View
                android:id="@+id/vPastelOnlineDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|right"
                android:layout_marginRight="1dp"
                android:layout_marginBottom="1dp"
                android:background="@drawable/bg_offline_dot" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/classicRightMeta"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:gravity="right|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPastelTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPastelUnread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_unread_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="18dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@id/classicRightMeta"
            android:layout_toRightOf="@id/flClassicAvatar"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPastelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPastelAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@我"
                    android:textColor="@color/home_row_subtitle_mention"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPastelTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPastelSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_row_subtitle_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 保留渲染器兼容字段，经典模式不显示装饰预览条。 -->
        <View
            android:id="@+id/vPastelPreviewBar"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />
    </RelativeLayout>

    <!-- 原生列表内缩分割线：从名称文字起点延伸至屏幕右边。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:layout_marginLeft="74dp"
        android:background="@color/color_surface_stroke" />
</com.im.oldchat.ui.widget.TiltFrameLayout>
