<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="4dp"
    android:paddingRight="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvDpiScalePercentValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_dpi_standard"
        android:textColor="@color/color_text_primary"
        android:textSize="16sp" />

    <SeekBar
        android:id="@+id/seekDpiScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/settings_dpi_input_label"
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etDpiScalePercent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/settings_dpi_input_hint"
        android:inputType="number"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/color_text_primary"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/layoutStartupThemeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_startup_theme_mode"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbStartupThemeLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_light_mode"
                android:textColor="@color/color_text_primary" />

            <RadioButton
                android:id="@+id/rbStartupThemeDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/settings_dark_mode"
                android:textColor="@color/color_text_primary" />
        </RadioGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutStartupShapeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_startup_button_shape"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbStartupCornersRound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_button_shape_round"
                android:textColor="@color/color_text_primary" />

            <RadioButton
                android:id="@+id/rbStartupCornersSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/settings_button_shape_square"
                android:textColor="@color/color_text_primary" />
        </RadioGroup>
    </LinearLayout>
</LinearLayout>
