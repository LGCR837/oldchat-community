<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@+id/btnScratchBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/moment_action_transparent"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_nav_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="每日刮刮乐"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider" />

    <ProgressBar
        android:id="@+id/pbScratchLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/color_divider"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvScratchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="今日还未刮奖，试试手气吧"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvScratchBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="旧币余额：-"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutScratchSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvScratchSlot0"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flat_row_selector"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScratchSlot1"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flat_row_selector"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScratchSlot2"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flat_row_selector"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScratchSlot3"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flat_row_selector"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScratchSlot4"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flat_row_selector"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvScratchHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="中奖概率很高，每天可刮一次"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnScratchGo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/flat_button_bg"
                android:gravity="center"
                android:text="刮一刮"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
