<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="0dp"
        android:paddingTop="12dp"
        android:paddingRight="0dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="&#x53D1;&#x73B0;"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiscoverTileHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="长按磁贴可调整大小"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp" />

        <com.im.oldchat.ui.widget.DiscoverTileLayout
            android:id="@+id/discoverTileGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/discoverClassicList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="小程序"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone"
            android:textSize="11sp" />

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverLua"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView
                    android:id="@+id/ivDiscoverIconMiniApp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_mini_app" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="44dp"
                    android:layout_marginRight="22dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lua 小程序"
                        android:textColor="@color/color_text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="原生界面与相机能力示例"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:tint="@color/color_text_secondary"
                    app:srcCompat="@android:drawable/ic_media_next" />
            </RelativeLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverCipDeveloper"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_developer_mode"
                    android:tint="@color/color_text_primary" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="开发 CIP 应用"
                        android:textColor="@color/color_text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="代码编辑、文件管理、测试与预览"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:tint="@color/color_text_secondary"
                    app:srcCompat="@android:drawable/ic_media_next" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/btnImportLuaCip"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="导入本地 CIP"
                android:textAllCaps="false"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnLuaCipDocs"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:text="开发文档"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/luaAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDiscoverSocialSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="&#x793E;&#x4EA4;"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp" />

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverMoments"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <ImageView
                    android:id="@+id/ivDiscoverMomentsIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_discover_moments" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="12dp"
                    android:layout_toRightOf="@id/ivDiscoverMomentsIcon"
                    android:text="&#x670B;&#x53CB;&#x5708;"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp" />

                <View
                    android:id="@+id/viewDiscoverMomentsDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_centerVertical="true"
                    android:layout_toLeftOf="@id/ivMomentsChevron"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/bg_badge_dot"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivMomentsChevron"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@android:drawable/ic_media_next"
                    android:tint="@color/color_text_secondary" />
            </RelativeLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverEmoji"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconEmoji" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_discover_emoji_plaza" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x8868;&#x60C5;&#x5E7F;&#x573A;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverMusic"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconMusic" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_discover_music" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x97F3;&#x4E50;&#x5E7F;&#x573A;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverResources"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconResources" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_document" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="资源广场" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverMinimalNews"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconMinimalNews" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_minimal_news" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x6781;&#x7B80;&#x7B80;&#x8BAF;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverOldView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconOldView" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_discover_old_view" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x65E7;&#x89C6;&#x754C;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <TextView
            android:id="@+id/tvDiscoverToolsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="&#x5DE5;&#x5177;"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp" />

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverCheckIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconCheckIn" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_discover_qiandao" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x6BCF;&#x65E5;&#x7B7E;&#x5230;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverScratch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconScratch" android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@android:drawable/star_big_on" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x6BCF;&#x65E5;&#x5212;&#x5212;&#x4E50;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverReport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconReport" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_discover_report" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x4E3E;&#x62A5;&#x8FDB;&#x5EA6;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverPublicCourt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconPublicCourt" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_discover_fating" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x516C;&#x5F00;&#x6CD5;&#x5EAD;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverMiniApps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="14dp" android:paddingRight="14dp">
                <ImageView android:id="@+id/ivMiniAppRowIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mini_app" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="小程序" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:tint="@color/color_text_secondary" app:srcCompat="@android:drawable/ic_media_next" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>

        <com.im.oldchat.ui.widget.TiltFrameLayout
            android:id="@+id/btnDiscoverSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_flat_row_selector">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">
                <ImageView android:id="@+id/ivDiscoverIconSettings" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_setting_appearance" android:tint="@color/color_text_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:text="&#x53D1;&#x73B0;&#x8BBE;&#x7F6E;" android:textColor="@color/color_text_primary" android:textSize="15sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@android:drawable/ic_media_next" android:tint="@color/color_text_secondary" />
            </LinearLayout>
        </com.im.oldchat.ui.widget.TiltFrameLayout>
    </LinearLayout>
</ScrollView>
