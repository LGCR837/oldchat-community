<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@+id/btnReportBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/moment_action_transparent"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_nav_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="举报违规与证据提请"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider" />

    <ProgressBar
        android:id="@+id/pbReportLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/color_divider"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 被举报人信息卡片 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="被举报人信息"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group_manage_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivReportTargetAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/usershead" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReportTargetName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="用户名称"
                        android:textColor="@color/color_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReportTargetUid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="UID: USR-000000"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvReportSourceTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="来源：私聊会话"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 涉案证据记录卡片 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="涉案聊天证据 / 记录"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_report_evidence_box"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvReportEvidenceContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="暂无关联消息记录"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 违规类型选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="违规类型"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group_manage_card"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp">

                <RadioGroup
                    android:id="@+id/rgReportCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbReportCat1"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:checked="true"
                        android:text="发布淫秽色情 / 低俗内容"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbReportCat2"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="网络诈骗 / 诱导私下转账交易"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbReportCat3"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="人身攻击 / 辱骂威胁 / 骚扰"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbReportCat4"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="垃圾广告 / 恶意刷屏引流"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbReportCat5"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="违法违规 / 涉政暴恐有害信息"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbReportCat6"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="其他违规行为"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- 举报证词与详细说明 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="举报证词与具体说明"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReportTestimonyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/500"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etReportTestimony"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_report_input_box"
                android:gravity="top|left"
                android:hint="请详细填写对方的违规事实、具体经过与您的证词（该内容将直接呈现在公众法庭案件中，作为大众陪审团投票与二审管理员定罪的核心证据）..."
                android:lineSpacingExtra="3dp"
                android:maxLength="500"
                android:minLines="4"
                android:padding="12dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="14sp" />

            <!-- 举报处理渠道（公开法庭 / 单独举报到审核） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="举报处理渠道"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group_manage_card"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp">

                <RadioGroup
                    android:id="@+id/rgReportDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbReportDestCourt"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:checked="true"
                        android:text="举报到公开法庭 (全服陪审团初审 + 管理员二审)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbReportDestAudit"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="单独举报到审核 (仅提交给官方审核员单独审查)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- 审理与处置须知卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_group_manage_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvReportNoticeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="公开法庭审理须知"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReportNoticeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="1. 提交后系统将自动生成公开法庭案件，由全服大众陪审团进行民主初审，并由管理员进行二审终审。\n2. 若法庭与二审确认违规并执行封号，违规者将被扣除 100 信誉分。\n3. 请如实提供证据与陈述证词，如果您的举报不合理/无意义，我们可能会封禁您的账户。"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 提交按钮 -->
            <TextView
                android:id="@+id/btnSubmitReport"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="提交举报并进入公开法庭"
                android:textColor="@color/color_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
