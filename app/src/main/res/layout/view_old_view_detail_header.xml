<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOldViewDetailHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_old_view_detail_card"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">
    <LinearLayout
        android:id="@+id/layoutOldViewOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/ivOldViewDetailOwnerAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_round"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_placeholder" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvOldViewDetailOwnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvOldViewDetailOwnerTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_old_view_stat"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="@string/old_view_owner_tag"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/btnOldViewSubscribe"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_old_view_action_active"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/old_view_action_subscribe"
            android:textColor="@color/color_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvOldViewDetailVideoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/color_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvOldViewDetailMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp" />
    <LinearLayout
        android:id="@+id/layoutOldViewStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="4">
        <TextView
            android:id="@+id/tvOldViewDetailStatPlay"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_old_view_stat"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvOldViewDetailStatDanmaku"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_old_view_stat"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvOldViewDetailStatReply"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_old_view_stat"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvOldViewDetailStatLike"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_old_view_stat"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layoutOldViewVideoActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnOldViewVideoLike"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_old_view_action_inactive"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="点赞"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btnOldViewVideoFavorite"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_old_view_action_inactive"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="收藏"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btnOldViewVideoShare"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_old_view_action_inactive"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="分享"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvOldViewVideoActionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@color/color_text_secondary"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/tvOldViewDetailSummaryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/old_view_summary"
        android:textColor="@color/color_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvOldViewDetailDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/color_divider" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabOldViewRelated"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/old_view_related_videos"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabOldViewComments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/old_view_comments"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewOldViewTabIndicatorRelated"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#E8400F" />

            <View
                android:id="@+id/viewOldViewTabIndicatorComments"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
