<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="12dp"
        android:orientation="horizontal"
        android:background="@color/color_background">

        <com.im.oldchat.ui.widget.FontAwesomeTextView
            android:id="@+id/btnChannelDiscoveryBack"
            android:layout_width="@dimen/chat_header_control_size"
            android:layout_height="@dimen/chat_header_control_size"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:includeFontPadding="false"
            android:padding="8dp"
            android:text="&#xf060;"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvChannelDiscoveryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="频道"
            android:textSize="@dimen/chat_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_field"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="8dp">

        <ImageView
            android:id="@+id/tvChannelSearchIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:tint="@color/color_text_secondary"
            app:srcCompat="@android:drawable/ic_menu_search" />

        <EditText
            android:id="@+id/etChannelSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@null"
            android:singleLine="true"
            android:hint="搜索"
            android:imeOptions="actionSearch"
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/btnChannelSearch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="6dp"
            android:text="搜索"
            android:textSize="14sp"
            android:textColor="@color/color_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/channelDiscoveryProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listChannelDiscovery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/color_surface_stroke"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent"
        android:background="@color/color_background" />
</LinearLayout>
