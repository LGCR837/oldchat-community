<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvMessageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_time_label"
        android:textColor="@color/color_text_secondary"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:visibility="gone" />

    <LinearLayout 
        android:id="@+id/message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

    <com.im.oldchat.ui.widget.RoundedImageView
        android:id="@+id/ivAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="6dp"
        android:contentDescription="@null"
        android:background="@drawable/bg_avatar_round"
        app:srcCompat="@drawable/ic_avatar_placeholder"
        app:cornerRadius="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/message_pending_side"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginRight="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbMessagePendingDeterminate"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_marginRight="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMessagePendingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="0%"
            android:textColor="@color/color_text_secondary"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMessagePendingFailed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_send_failed"
            android:textColor="@color/colorDanger"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout 
        android:id="@+id/content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sender_row_outside"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSenderNameOutside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvSenderBadgeOutside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="群主"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSenderTitleOutside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="头衔"
                android:textColor="#A855F7"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:id="@+id/sender_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSenderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvSenderBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="群主"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSenderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="头衔"
                    android:textColor="#A855F7"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quote_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:padding="6dp"
                android:visibility="gone">

                <View
                    android:id="@+id/vQuoteLine"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="7dp"
                    android:background="@color/colorReplyHighlight" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuoteSender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxWidth="200dp"
                        android:singleLine="true"
                        android:textColor="@color/colorReplyHighlight"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivQuoteImage"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginRight="6dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvQuoteContent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="3"
                            android:maxWidth="200dp"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        <LinearLayout
            android:id="@+id/message_text_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.im.oldchat.ui.widget.BubbleTimeTextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp"
                android:includeFontPadding="false" />

            <!-- 非文本消息的独立时间/发送状态行；文本消息由 BubbleTimeTextView 自绘 footer。 -->
            <TextView
                android:id="@+id/tvMessageFooterTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_gravity="bottom"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/color_text_secondary"
                android:textSize="9sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbMessagePending"
                style="@android:style/Widget.ProgressBar.Small"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginLeft="4dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/message_status_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivMessageStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/sent" />

                <TextView
                    android:id="@+id/tvReadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

            <com.im.oldchat.ui.widget.ButtonFlowLayout
                android:id="@+id/message_button_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/resource_card"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/flResourceCover"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <com.im.oldchat.ui.widget.RoundedImageView
                        android:id="@+id/ivResourceCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        app:cornerRadius="12dp"
                        app:srcCompat="@drawable/bg_image_placeholder" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#22000000" />

                    <ImageView
                        android:id="@+id/ivResourcePlay"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_action_video" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivResourceIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_document" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvResourceTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/color_text_primary"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvResourceSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="11sp"
                            android:textColor="@color/color_text_secondary"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvResourceAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:text="下载"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbFileUpload"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llResourceFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvResourceTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="9sp"
                        android:textColor="@color/color_text_secondary"
                        android:includeFontPadding="false"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivResourceStatus"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="3dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_msg_sent" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/red_packet_container"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRedPacketIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_red_packet" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRedPacketTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/color_on_primary"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvRedPacketDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="12sp"
                            android:textColor="@color/color_on_primary"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRedPacketOpenTip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/red_packet_open_tip"
                        android:textSize="11sp"
                        android:textColor="@color/color_on_primary"
                        android:includeFontPadding="false" />

                    <ImageView
                        android:id="@+id/ivRedPacketStatus"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_msg_sent" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/image_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <com.im.oldchat.ui.widget.RoundedImageView
                    android:id="@+id/ivMessageImage"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:srcCompat="@drawable/ic_avatar_placeholder" />

                <ProgressBar
                    android:id="@+id/pbImageLoading"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivVideoPlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_action_video" />

                <LinearLayout
                    android:id="@+id/llImageTimeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_time_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvImageTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:includeFontPadding="false" />

                    <ImageView
                        android:id="@+id/ivImageStatus"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="3dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/sent" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout 
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout 
                    android:id="@+id/voice_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivVoiceIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_voice" />

                    <ProgressBar
                        android:id="@+id/pbVoiceLoading"
                        style="@android:style/Widget.ProgressBar.Small"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginLeft="4dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvVoiceDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="1&quot;"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvVoiceTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="10sp"
                        android:includeFontPadding="false"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/message_status_media_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivMessageStatusMedia"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/sent" />

                    <TextView
                        android:id="@+id/tvReadCountMedia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVoiceTranscript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxWidth="210dp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_quote_preview"
                android:textColor="@color/color_text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="1dp"
                android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    <com.im.oldchat.ui.widget.RoundedImageView
        android:id="@+id/ivAvatarRight"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:contentDescription="@null"
        android:background="@drawable/bg_avatar_round"
        app:srcCompat="@drawable/ic_avatar_placeholder"
        app:cornerRadius="0dp"
        android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
