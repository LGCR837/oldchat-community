<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface"
    android:clipChildren="false"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_moments_cover_placeholder">

        <ImageView
            android:id="@+id/ivSpaceCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="个人封面"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#18000000" />

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/btnSpaceBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|left"
            android:layout_margin="8dp"
            android:background="@drawable/bg_space_back_button"
            android:contentDescription="返回"
            android:padding="11dp"
            app:srcCompat="@drawable/ic_nav_back"
            app:tint="@color/color_on_primary" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:clipChildren="false">

        <com.im.oldchat.ui.widget.RoundedImageView
            android:id="@+id/ivSpaceAvatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="top|left"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="-44dp"
            android:contentDescription="用户头像"
            android:scaleType="centerCrop"
            app:cornerRadius="44dp"
            app:srcCompat="@drawable/ic_avatar_placeholder" />

        <LinearLayout
            android:id="@+id/space_button_row"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|right"
            android:layout_marginTop="7dp"
            android:layout_marginRight="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSpacePost"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="发布动态"
                android:textColor="@color/color_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSpaceEdit"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/button_outline_primary"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="编辑资料"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/space_action_row"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|right"
            android:layout_marginTop="7dp"
            android:layout_marginRight="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnSpaceReport"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/button_outline_danger"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="举报"
                android:textColor="@color/colorDanger"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSpacePrimary"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:minWidth="92dp"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="加好友"
                android:textColor="@color/color_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="230dp"
                android:textColor="@color/color_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpaceTitleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_badge_title"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="90dp"
                android:paddingLeft="4dp"
                android:paddingTop="1dp"
                android:paddingRight="4dp"
                android:paddingBottom="1dp"
                android:textColor="@color/color_on_primary"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSpaceUid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSpaceSignature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpaceMomentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 条动态"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="#e5e7eb" />

            <TextView
                android:id="@+id/tvSpaceBanCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史封禁: 0 次"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="动态"
        android:textColor="@color/color_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/colorPrimary" />
</LinearLayout>
