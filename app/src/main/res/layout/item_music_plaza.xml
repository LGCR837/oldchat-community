<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_list_item_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_music_plaza_cover_frame"
            android:padding="3dp">

            <ImageView
                android:id="@+id/ivMusicPlazaCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_music_player_cover_inner_themed"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMusicPlazaTag"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_music_plaza_tag_positive"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:text="广场"
                    android:textColor="@color/music_plaza_chip_accent_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMusicPlazaDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_music_plaza_stat_chip"
                    android:gravity="center"
                    android:minWidth="50dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="--:--"
                    android:textColor="@color/music_plaza_meta_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMusicPlazaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="歌曲名称"
                android:textColor="@color/music_plaza_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMusicPlazaOwner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_music_plaza_stat_chip"
                android:ellipsize="end"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:text="上传者"
                android:textColor="@color/music_plaza_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvMusicPlazaMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_music_plaza_stat_chip"
        android:ellipsize="end"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="大小 0KB"
        android:textColor="@color/music_plaza_text_secondary"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMusicPlazaStats"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_music_plaza_stat_chip"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="赞 0 · 评论 0"
            android:textColor="@color/music_plaza_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnMusicPlazaPlay"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_music_plaza_play_button"
            android:gravity="center"
            android:minWidth="62dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="播放"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMusicPlazaMore"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_profile_item"
            android:gravity="center"
            android:minWidth="62dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="更多"
            android:textColor="@color/music_plaza_text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
