<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerOldView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/color_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/color_surface"
            android:paddingLeft="8dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/btnOldViewMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/color_text_primary"
                android:textSize="24sp"
                android:contentDescription="@string/old_view_action_menu" />

            <TextView
                android:id="@+id/tvOldViewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/old_view_title"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnOldViewSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="@null" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbOldViewLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvOldViewEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/old_view_empty"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/lvOldViewVideos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <!-- 侧栏 -->
    <LinearLayout
        android:id="@+id/drawerOldViewSide"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/color_surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/color_surface"
            android:paddingLeft="16dp"
            android:paddingTop="24dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/old_view_title"
                android:textColor="@color/color_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOldViewSideStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/old_view_status_guest"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 导航功能（YouTube 抽屉风格：图标 + 文字） -->
        <LinearLayout
            android:id="@+id/btnOldViewSideBackDiscover"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_flat_row_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/color_text_primary"
                app:srcCompat="@android:drawable/ic_menu_revert"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/old_view_action_back_discover"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOldViewSideHome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_flat_row_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/color_text_primary"
                app:srcCompat="@android:drawable/ic_menu_compass"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/old_view_action_recommend"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOldViewSideSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_flat_row_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/color_text_primary"
                app:srcCompat="@android:drawable/ic_menu_search"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/old_view_action_search"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOldViewSideHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_flat_row_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/color_text_primary"
                app:srcCompat="@android:drawable/ic_menu_agenda"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/old_view_action_history"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOldViewSideFavorites"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_flat_row_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/color_text_primary"
                app:srcCompat="@android:drawable/ic_menu_gallery"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/old_view_action_favorites"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/color_divider" />

        <!-- 登录/退出 -->
        <LinearLayout
            android:id="@+id/btnOldViewSideLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_flat_row_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/color_text_primary"
                app:srcCompat="@android:drawable/ic_menu_myplaces"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/old_view_action_login"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOldViewSideLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_flat_row_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone">

            <android.support.v7.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/color_text_secondary"
                app:srcCompat="@android:drawable/ic_lock_lock"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/old_view_action_logout"
                android:textColor="@color/color_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 登录二维码面板（侧栏内） -->
        <LinearLayout
            android:id="@+id/panelOldViewLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_profile_item"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOldViewLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/old_view_login_title"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivOldViewQr"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:scaleType="centerInside"
                android:background="@color/color_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvOldViewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/old_view_status_fetch_qr"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOldViewRefresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="@string/old_view_action_refresh_qr"
                android:textSize="13sp"
                android:background="@drawable/bg_primary_button"
                android:textColor="@color/color_on_primary" />
        </LinearLayout>
    </LinearLayout>

</android.support.v4.widget.DrawerLayout>
