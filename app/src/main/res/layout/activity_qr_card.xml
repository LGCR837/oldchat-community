<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/btnQrCardBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/color_text_primary" />

        <TextView
            android:id="@+id/tvQrCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="&#x4E8C;&#x7EF4;&#x7801;"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_item"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvQrCardDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="&#x52A0;&#x597D;&#x53CB;&#x6216;&#x5165;&#x7FA4;&#x4E8C;&#x7EF4;&#x7801;"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivQrCard"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_marginTop="16dp"
                    android:background="#FFFFFFFF"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_report_image" />

                <TextView
                    android:id="@+id/tvQrCardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="&#x4F7F;&#x7528;&#x65E7;&#x804A;&#x626B;&#x7801;&#x53EF;&#x76F4;&#x63A5;&#x8BC6;&#x522B;"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveQrCard"
                style="@style/FlatButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="&#x4FDD;&#x5B58;&#x4E8C;&#x7EF4;&#x7801;&#x5230;&#x672C;&#x5730;"
                android:textColor="@color/color_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
