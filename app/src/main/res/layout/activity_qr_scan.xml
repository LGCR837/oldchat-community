<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/btnQrScanBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/color_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="&#x626B;&#x7801;&#x8BC6;&#x522B;"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <android.support.v7.widget.AppCompatImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@null"
            app:srcCompat="@android:drawable/ic_menu_camera"
            android:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="&#x626B;&#x63CF;&#x7FA4;&#x4E8C;&#x7EF4;&#x7801;&#x53EF;&#x5165;&#x7FA4;&#xFF0C;&#x626B;&#x63CF;&#x7528;&#x6237;&#x540D;&#x7247;&#x53EF;&#x52A0;&#x597D;&#x53CB;"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnScanFromCamera"
            style="@style/FlatButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="&#x62CD;&#x7167;&#x626B;&#x7801;"
            android:textColor="@color/color_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnScanFromGallery"
            style="@style/FlatButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="&#x4ECE;&#x76F8;&#x518C;&#x9009;&#x62E9;&#x4E8C;&#x7EF4;&#x7801;"
            android:textColor="@color/color_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQrScanHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="&#x626B;&#x7801;&#x6210;&#x529F;&#x540E;&#x4F1A;&#x81EA;&#x52A8;&#x8FD4;&#x56DE;&#x5E76;&#x6267;&#x884C;"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
